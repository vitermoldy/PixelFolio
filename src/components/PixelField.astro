---
/*
 * Lapisan piksel untuk seluruh situs + kontrolnya.
 * Kontrol wajib ada (antislop R-39): efek bergerak lebih dari 5 detik harus bisa dihentikan.
 */
import { palettes } from '../data/palettes';

const sizes = [
  { id: 1, label: 'S', name: 'Kuas kecil' },
  { id: 2, label: 'M', name: 'Kuas sedang' },
  { id: 3, label: 'L', name: 'Kuas besar' },
];
---

<canvas class="px-field" data-px-field aria-hidden="true"></canvas>

<div class="pxctl" role="group" aria-label="Efek piksel" data-pxctl>
  <button type="button" class="pxctl-toggle" data-px-toggle aria-pressed="true">
    <span class="pxctl-dot" aria-hidden="true"></span>
    <span class="pxctl-text">Piksel</span>
    <span class="visually-hidden">: efek kursor</span>
  </button>
  <span class="pxctl-sizes">
    <span class="pxctl-sep" aria-hidden="true"></span>
    {
      sizes.map((s) => (
        <button type="button" class="pxctl-size" data-px-size={s.id} aria-pressed={s.id === 2 ? 'true' : 'false'} aria-label={s.name}>
          <span aria-hidden="true">{s.label}</span>
        </button>
      ))
    }
  </span>
  <span class="pxctl-sep" aria-hidden="true"></span>
  <span class="pxctl-palettes" role="group" aria-label="Palet warna">
    {
      palettes.map((p) => (
        <button type="button" class="pxctl-palette" data-px-palette={p.id} aria-pressed="false" aria-label={`Palet ${p.name}`} title={p.name}>
          {/* data-palette di sini membuat contoh warna memakai palet tombol itu sendiri */}
          <span class="pxctl-swatch" data-palette={p.id} aria-hidden="true">
            <i />
            <i />
            <i />
            <i />
          </span>
        </button>
      ))
    }
  </span>
  <p class="visually-hidden" role="status" data-px-status></p>
</div>

<script>
  import { mountPixelField } from '../scripts/pixelField';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-px-field]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-px-toggle]');
  const sizeBtns = document.querySelectorAll<HTMLButtonElement>('[data-px-size]');
  const paletteBtns = document.querySelectorAll<HTMLButtonElement>('[data-px-palette]');
  const status = document.querySelector<HTMLElement>('[data-px-status]');

  if (canvas && toggle) {
    const field = mountPixelField(canvas);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const read = (k: string) => {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    };
    const write = (k: string, val: string) => {
      try {
        localStorage.setItem(k, val);
      } catch {
        /* mode privat: pilihan tidak disimpan */
      }
    };

    const stored = read('pf-pixels');
    const setOn = (on: boolean, save: boolean) => {
      toggle.setAttribute('aria-pressed', String(on));
      document.documentElement.toggleAttribute('data-px-off', !on);
      field?.setEnabled(on);
      if (save) write('pf-pixels', on ? 'on' : 'off');
    };
    setOn(stored ? stored === 'on' : !reduced, false);
    toggle.addEventListener('click', () => setOn(toggle.getAttribute('aria-pressed') !== 'true', true));

    const setSize = (n: 1 | 2 | 3, save: boolean) => {
      sizeBtns.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.pxSize) === n)));
      field?.setBrush(n);
      if (save) write('pf-brush', String(n));
    };
    const storedSize = Number(read('pf-brush'));
    setSize(storedSize === 1 || storedSize === 3 ? storedSize : 2, false);
    sizeBtns.forEach((b) => b.addEventListener('click', () => setSize(Number(b.dataset.pxSize) as 1 | 2 | 3, true)));

    // palet: atribut di <html> mengganti semua variabel warna; efek dan nama di footer membaca ulang warnanya
    const root = document.documentElement;
    const themeColour = document.querySelector('meta[name="theme-color"]');
    const markPalette = () => {
      paletteBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pxPalette === root.dataset.palette)));
      themeColour?.setAttribute('content', getComputedStyle(root).getPropertyValue('--paper').trim());
    };
    markPalette();
    paletteBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.pxPalette;
        if (!id || id === root.dataset.palette) return;
        root.dataset.palette = id;
        write('pf-palette', id);
        markPalette();
        field?.refreshColours();
        dispatchEvent(new CustomEvent('pf:palette', { detail: id }));
        if (status) status.textContent = `Palet ${b.title} dipakai.`;
      }),
    );
  }
</script>

